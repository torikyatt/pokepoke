{
  "name": "pokepoke",
  "version": "1.0.0",
  "description": "ポケポケのカード検索・デッキビルダー",
  "scripts": {
    "dev": "npm run build-index && vite",
    "build": "npm run build-index && vite build && vite build --mode single && tsx scripts/finish-build.ts",
    "preview": "vite preview",
    "test": "npm run build-index && vitest run",
    "typecheck": "tsc -p .",
    "fetch": "tsx scripts/fetch.ts",
    "normalize": "tsx scripts/normalize.ts",
    "names-ja": "tsx scripts/names-ja.ts",
    "scrape-game8": "tsx scripts/scrape-game8.ts",
    "match-ja": "tsx scripts/match-ja.ts",
    "translate": "tsx scripts/translate.ts",
    "tag": "tsx scripts/tag.ts",
    "lexicon-gen": "tsx scripts/lexicon-gen.ts",
    "validate": "tsx scripts/validate.ts",
    "thumbs": "tsx scripts/thumbs.ts",
    "build-index": "tsx scripts/build-index.ts",
    "data": "npm run normalize && npm run names-ja && npm run match-ja && npm run translate && npm run tag && npm run lexicon-gen && npm run validate && npm run build-index",
    "fetch-meta": "tsx scripts/fetch-meta.ts"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "js-yaml": "^5.4.2",
    "kuromoji": "^0.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "private": true
}
